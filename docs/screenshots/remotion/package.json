{
  "name": "jet-demo",
  "version": "1.0.0",
  "scripts": {
    "start": "remotion studio",
    "build": "remotion render src/index.ts JetDemo output.mp4",
    "gif": "remotion render src/index.ts JetDemo output.gif --codec=gif --every-nth-frame=2 --number-of-gif-loops=0",
    "gif:hero": "remotion render src/index.ts JetDemo ../../hero.gif --codec=gif --every-nth-frame=2 --number-of-gif-loops=0"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.0",
    "@remotion/cli": "^4.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.5.0"
  }
}